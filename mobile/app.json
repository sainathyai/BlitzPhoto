{
  "expo": {
    "name": "BlitzPhoto",
    "slug": "blitzphoto-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.blitzphoto.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "BlitzPhoto needs access to your camera to take photos for upload.",
        "NSPhotoLibraryUsageDescription": "BlitzPhoto needs access to your photo library to select photos for upload."
      }
    },
    "android": {
      "package": "com.blitzphoto.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BlitzPhoto to access your photos",
          "cameraPermission": "Allow BlitzPhoto to use your camera"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BlitzPhoto to use your camera"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:8080/api/v1"
    }
  }
}
